{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "joelclermont-com",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-01",
  "routes": [
    { "pattern": "joelclermont.com", "custom_domain": true },
    { "pattern": "www.joelclermont.com", "custom_domain": true }
  ],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  "vars": {
    "CONTACT_FROM": "contact@joelclermont.com",
    "CONTACT_TO": "me@jclermont.com"
  },
  "send_email": [
    {
      "name": "CONTACT_EMAIL",
      "destination_address": "me@jclermont.com"
    }
  ]
}
